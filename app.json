{
  "expo": {
    "name": "Buaic",
    "slug": "buaic-workout-tracker",
    "scheme": "buaic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.buaic",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.buaic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D4AF37"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F0F",
          "imageWidth": 200
        }
      ],
      "./plugins/withShortCmakeObjectPaths",
      "expo-router",
      "expo-font",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.buaic.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.buaic",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "BuaicWidget",
              "displayName": "Buaic",
              "description": "This week’s workouts, your streak and the next routine.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ],
      [
        "./plugins/withWidgetDeepLink",
        {
          "widgetName": "BuaicWidget"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b406ed5-a625-4f79-81f6-c4fc81dfac40"
      }
    }
  }
}
